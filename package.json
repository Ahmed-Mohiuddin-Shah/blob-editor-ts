{
  "name": "blob-editor",
  "version": "0.3.0",
  "description": "BLOB Composition editor — portable core + React drop-in UI",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./encode": {
      "types": "./dist/encode.d.ts",
      "import": "./dist/encode.js"
    },
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "import": "./dist/prepare.js"
    },
    "./print": {
      "types": "./dist/core/print/index.d.ts",
      "import": "./dist/core/print/index.js"
    },
    "./react/blob-editor.css": "./src/react/blob-editor.css"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "gifenc": "^1.0.3",
    "pdf-lib": "^1.17.1"
  },
  "files": [
    "dist",
    "src/react/blob-editor.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed-Mohiuddin-Shah/blob-editor-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Ahmed-Mohiuddin-Shah/blob-editor-ts/issues"
  },
  "homepage": "https://github.com/Ahmed-Mohiuddin-Shah/blob-editor-ts#readme",
  "keywords": [
    "blob",
    "composition",
    "sticker",
    "editor",
    "react",
    "konva"
  ],
  "author": "Ahmed Mohiuddin Shah",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "konva": "^9.3.20",
    "omggif": "^1.0.10",
    "react-konva": "^19.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas": "^3.2.3",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
